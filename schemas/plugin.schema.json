{
  "$id": "https://telepilot.local/schemas/plugin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "plugin.json 的 Pydantic 校验模型。\n\n只允许静态解析，不执行任何 Python 代码。\n所有字段在通过校验后才返回 PluginMetadata。",
  "properties": {
    "agent_tools": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Agent Tools",
      "type": "array"
    },
    "author": {
      "default": "",
      "title": "Author",
      "type": "string"
    },
    "capabilities": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capabilities"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "config_actions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Config Actions",
      "type": "array"
    },
    "config_schema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Schema"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "display_name": {
      "default": "",
      "title": "Display Name",
      "type": "string"
    },
    "entry": {
      "default": "plugin.py",
      "title": "Entry",
      "type": "string"
    },
    "event_subscriptions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Event Subscriptions",
      "type": "array"
    },
    "interaction_entries": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Interaction Entries",
      "type": "array"
    },
    "interaction_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interaction Profile"
    },
    "key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key"
    },
    "min_telebot_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Telebot Version"
    },
    "min_telepilot_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Telepilot Version"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "requires_platform_capabilities": {
      "items": {
        "enum": [
          "ai",
          "interaction_bot",
          "webhooks",
          "ledger",
          "dispatch_debug"
        ],
        "type": "string"
      },
      "title": "Requires Platform Capabilities",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "usage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage"
    },
    "version": {
      "default": "0.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "TelePilot plugin.json",
  "type": "object"
}
